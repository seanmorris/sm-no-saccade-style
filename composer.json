{
  "name": "seanmorris/sm-no-saccade-style",
  "description": "PHP-CS-Fixer style package for left-rail punctuation, Allman blocks, tabs, and tight control parens.",
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Sean Morris"
    }
  ],
  "archive": {
    "exclude": [
      "/.editorconfig",
      "/.env",
      "/.github",
      "/.gitignore",
      "/composer.lock",
      "/docs",
      "/node_modules",
      "/package-lock.json",
      "/package.json",
      "/packages/js",
      "/packages/php/.php-cs-fixer.php",
      "/packages/php/.phpunit.cache",
      "/packages/php/build",
      "/packages/php/phpunit.xml",
      "/packages/php/services",
      "/packages/php/tests",
      "/packages/php/vendor",
      "/scripts",
      "/vendor"
    ]
  },
  "require": {
    "php": "^8.2",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "SeanMorris\\NoSaccadeStyle\\": "packages/php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SeanMorris\\NoSaccadeStyle\\Tests\\": "packages/php/tests/"
    }
  },
  "scripts": {
    "lint": "php-cs-fixer fix --config=packages/php/.php-cs-fixer.php --dry-run --diff --verbose",
    "lint:fix": "php-cs-fixer fix --config=packages/php/.php-cs-fixer.php --verbose",
    "test": "phpunit --configuration=packages/php/phpunit.xml",
    "coverage": "php -r \"if (!extension_loaded('xdebug') && !extension_loaded('pcov')) { fwrite(STDERR, 'No PHP coverage driver available; skipping PHP coverage.' . PHP_EOL); exit(1); }\" || exit 0; XDEBUG_MODE=coverage phpunit --configuration=packages/php/phpunit.xml --coverage-clover packages/php/build/logs/clover.xml --coverage-text"
  },
  "config": {
    "sort-packages": true
  }
}
